# php-cli for the shim tests, with the docker CLI where DockerMan's helpers expect it, and node
# for the API module tests, which run the shim the way unraid-api will.
# Unraid 7.2 ships PHP 8.3 (release notes 7.2.5 and 7.2.7), and no 7.3 release note changes it.
FROM php:8.3-cli
COPY --from=docker:cli /usr/local/bin/docker /usr/bin/docker
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
# Unraid's php.ini prepends this webgui file to every PHP run, the CLI included, so the shim
# loads it on a server. ci/test.sh mounts the webgui where the path points (REQ-TST-10).
RUN echo 'auto_prepend_file="/usr/local/emhttp/webGui/include/local_prepend.php"' > "$PHP_INI_DIR/conf.d/unraid.ini"
