<?xml version='1.0' standalone='yes'?>
<!-- SPDX-License-Identifier: GPL-2.0-or-later -->
<!-- The release workflow writes the version and sha256 entities into the .plg file of each candidate release, and a promotion brings that file here unchanged (REQ-PKG-23 to REQ-PKG-27). -->
<!DOCTYPE PLUGIN [
<!ENTITY name "tofuman">
<!ENTITY author "tomzorz">
<!ENTITY version "2026.10.04">
<!ENTITY sha256 "8dc5a210ff0f2a5501d9311d329aebfabb3f75a6edda00dd9f700c31bca586a2">
<!ENTITY github "tomzorz/tofuman">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/main/sources/plugin/tofuman.plg">
<!ENTITY package "&name;-&version;.tgz">
<!ENTITY packageURL "https://github.com/&github;/releases/download/plugin-&version;/&package;">
]>

<!-- REQ-PKG-21 and REQ-PKG-22: the plugin manager shows CHANGES as the release notes, links the icon to launch, and refuses an Unraid release below min. -->
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="https://github.com/&github;/issues" icon="code" launch="Docker" min="7.3.2">

<CHANGES>
### 2026.10.05
- Hand-made containers and Policy fold away and start closed. Their headings show the count, and Policy says how many entries it lacks.
- Adopt selected and Import blocks for all sit below their tables, as on the Docker page, and the Adopt button of each row is gone.
- Long changes and errors in the activity wrap inside their cells, three lines at most; the whole text shows on hover and in the operation.
- A chevron marks each activity line that opens an operation, the open line stands out, and the operation below it no longer lights up under the pointer.

### 2026.10.04
- tofu plan names each check that the server would refuse, before anything changes (with provider 0.2.0).
- A container that stops or restarts within its start check (10 seconds unless start_check says otherwise) fails the apply with its exit code and last log lines; an update puts the previous container back.
- Every operation leaves a line in operations.jsonl: its steps with timings, the docker command with masked values hidden, the pull digest, and the error.
- The tab shows the status at a glance, icons, WebUI links, whether each hand-made container can be adopted, Adopt for several containers at once, import blocks to paste into tofu, what the policy lacks with a button that adds it, each operation step by step, the last 7 days, and a diagnostics file to download.
- A tofu badge marks the managed containers on the Docker page.
- Unraid notifications when an operation fails, and when an Unraid release is untested.
- The policy can allow --ipc host for one container ("ipcHost": true in its exception).
- An update or a delete of a container without an icon no longer deletes the Docker page's default icon until the next boot (webgui 7.3.2).

### 2026.10.03
- A mutation no longer fails with "Bad Request Exception": unraid-api's global ValidationPipe no longer sees the definition.

### 2026.10.02
- The tested build counts only webgui files, local_prepend.php included, so a real server matches it.

### 2026.09.28
- First release.
</CHANGES>

<!-- The package stays on the flash drive, so each boot installs it without a download. -->
<FILE Name="/boot/config/plugins/&name;/&package;">
<URL>&packageURL;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- Runs at each install and at each boot, before emhttp starts unraid-api. -->
<FILE Run="/bin/bash">
<INLINE>
plugin=/usr/local/emhttp/plugins/&name;
find /boot/config/plugins/&name; -maxdepth 1 -name '&name;-*.tgz' ! -name '&package;' -delete
rm -rf "$plugin"
mkdir -p "$plugin"
if ! tar -xzf /boot/config/plugins/&name;/&package; -C "$plugin"; then
  echo "tofuman: cannot unpack &package;"
  exit 1
fi
echo '{"action":"initPolicy"}' | php "$plugin/shim/tofuman-shim.php" >/dev/null
php "$plugin/scripts/api-module.php" install &version;
echo "tofuman &version; is installed"
</INLINE>
</FILE>

<!-- REQ-PKG-7 and REQ-PKG-8: out of unraid-api; the registry, policy, audit log, templates, and containers stay. -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
plugin=/usr/local/emhttp/plugins/&name;
php "$plugin/scripts/api-module.php" remove
rm -rf "$plugin"
rm -f /boot/config/plugins/&name;/&name;-*.tgz
echo "tofuman is removed; its registry, policy, and audit log stay in /boot/config/plugins/&name;"
</INLINE>
</FILE>

</PLUGIN>
